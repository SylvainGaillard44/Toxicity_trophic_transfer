### Bar plot stacked toxin concentrations Alexandrium IC8B1

Tox <- read.csv("IC8B1_toxicity.csv", header = TRUE)

# Remove molecular weight and TEF
Tox <- Tox[-c(1,2),]
names(Tox)[1] <- "Sample"

# Long format
Tox <- pivot_longer(Tox, cols=-Sample, names_to="Toxin", values_to="Concentration")

#  or extra
Tox$Condition <- ifelse(grepl("Phyto_Cells", Tox$Sample), "", "Extra")

# Average for each toxin
Average <- aggregate(Concentration ~ Condition + Toxin, data=Tox, FUN=mean)
names(Average)[3] <- "Average"

# SD for each toxin
SD <- aggregate(Concentration ~ Condition + Toxin, data=Tox, FUN=sd)
names(SD)[3] <- "SD"

# Combine average and SD
Tox <- merge(Average, SD, by=c("Condition","Toxin"))

# Remove toxins equal to 0
Tox <- subset(Tox, Average != 0)

# Toxin order
Tox$Toxin <- factor(Tox$Toxin, levels=c("C1","C2","GTX5","GTX6","dc.GTX3","GTX3","GTX4","STX"))

# 
Tox_ <- subset(Tox, Condition=="")

# Extra
Tox_extra <- subset(Tox, Condition=="Extra")

